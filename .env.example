# Confluence → OpenWebUI Sync - Environment Variables
# Copy this file to .env and fill in the values.

# Confluence Data Center
CONFLUENCE_BASE_URL=https://confluence.ag.ch
CONFLUENCE_PAT=your-personal-access-token-here

# OpenWebUI
OPENWEBUI_BASE_URL=https://gpt-stage.ag.ch
OPENWEBUI_API_KEY=your-bearer-token-here

# PostgreSQL (sync state + mapping configuration)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Logging
LOG_LEVEL=INFO
